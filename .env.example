# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin whitelist (comma-separated emails autorizados a recibir magic link)
ADMIN_EMAILS=

# Resend (email transaccional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron retry endpoint (proteccion endpoint /api/cron/retry-emails)
CRON_SECRET=

# Database webhook secret (validacion de payload del webhook de Supabase)
SUPABASE_DB_WEBHOOK_SECRET=

# Spotify (Web API, Client Credentials flow para search de canciones)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
